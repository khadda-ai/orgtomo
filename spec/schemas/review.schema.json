{
  "$id": "review",
  "title": "Reviewer output",
  "type": "object",
  "required": [
    "key",
    "verdict",
    "rubric",
    "findings",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "key": {
      "$ref": "_defs#/$defs/ticketKey"
    },
    "verdict": {
      "enum": [
        "approve",
        "changes"
      ]
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "na"
            ]
          },
          "proof": {
            "$ref": "_defs#/$defs/evidenceIds"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "text",
          "proof"
        ],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "component": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "proof": {
            "$ref": "_defs#/$defs/proof"
          }
        }
      }
    },
    "claims": {
      "$ref": "_defs#/$defs/claims"
    },
    "self_review": {
      "$ref": "_defs#/$defs/selfReview"
    }
  }
}
