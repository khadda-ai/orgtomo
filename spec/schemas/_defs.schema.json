{
  "$id": "_defs",
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^E[0-9]{3,}$"
      }
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^E[0-9]{3,}$"
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "proof"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C[0-9]+$"
        },
        "text": {
          "type": "string",
          "minLength": 10
        },
        "proof": {
          "$ref": "_defs#/$defs/proof"
        },
        "basis": {
          "enum": [
            "measured",
            "carried",
            "inferred"
          ]
        },
        "source": {
          "type": "string"
        },
        "confirm_by": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "_defs#/$defs/claim"
      }
    },
    "ticketKey": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"
    },
    "componentRef": {
      "type": "string",
      "pattern": "^[A-Za-z]+:[A-Za-z0-9_.\\- ]+$"
    },
    "acId": {
      "type": "string",
      "pattern": "^AC[0-9]+$"
    },
    "selfReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elsewhere": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "withdrawn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_verified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
