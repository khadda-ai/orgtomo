{
  "$id": "plan",
  "title": "Planner output",
  "type": "object",
  "required": [
    "key",
    "approach",
    "components",
    "order",
    "tests",
    "manual_steps",
    "risks",
    "rollback",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "key": {
      "$ref": "_defs#/$defs/ticketKey"
    },
    "approach": {
      "type": "string",
      "minLength": 40
    },
    "alternatives_rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "option",
          "why_not"
        ],
        "additionalProperties": false,
        "properties": {
          "option": {
            "type": "string"
          },
          "why_not": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "change",
          "what",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "$ref": "_defs#/$defs/componentRef"
          },
          "change": {
            "enum": [
              "new",
              "modify",
              "delete"
            ]
          },
          "what": {
            "type": "string",
            "minLength": 5
          },
          "why": {
            "type": "string",
            "minLength": 5
          },
          "proof": {
            "$ref": "_defs#/$defs/evidenceIds"
          }
        }
      }
    },
    "order": {
      "type": "array",
      "items": {
        "$ref": "_defs#/$defs/componentRef"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "covers",
          "kind",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]+$"
          },
          "covers": {
            "type": "array",
            "items": {
              "$ref": "_defs#/$defs/acId"
            }
          },
          "kind": {
            "enum": [
              "apex",
              "ui",
              "data",
              "negative",
              "bulk",
              "regression"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "manual_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "when",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "when": {
            "enum": [
              "pre",
              "post"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "mitigation"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "docs": {
      "$ref": "_defs#/$defs/evidenceIds"
    },
    "rollback": {
      "type": "string",
      "minLength": 10
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "$ref": "_defs#/$defs/claims"
    },
    "regression_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regression_note": {
      "type": "string"
    },
    "self_review": {
      "$ref": "_defs#/$defs/selfReview"
    },
    "data_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "org",
          "what",
          "records"
        ],
        "additionalProperties": false,
        "properties": {
          "org": {
            "type": "string"
          },
          "what": {
            "type": "string",
            "minLength": 10
          },
          "records": {
            "type": "string",
            "minLength": 3
          },
          "reversible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
