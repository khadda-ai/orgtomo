{
  "$id": "understanding", "title": "Analyst output", "type": "object",
  "required": ["key", "summary_plain", "summary_technical", "acceptance_criteria", "examples", "affected", "open_questions", "risk", "lite_candidate", "claims"],
  "additionalProperties": false,
  "properties": {
    "key": { "$ref": "_defs#/$defs/ticketKey" },
    "summary_plain": { "type": "string", "minLength": 40 },
    "summary_technical": { "type": "string", "minLength": 40 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "text", "source"], "additionalProperties": false,
      "properties": { "id": { "$ref": "_defs#/$defs/acId" }, "text": { "type": "string", "minLength": 3 }, "source": { "enum": ["ticket", "derived", "meeting", "human"] } } } },
    "examples": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["title", "given", "when", "then"], "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "given": { "type": "string" }, "when": { "type": "string" }, "then": { "type": "string" } } } },
    "affected": { "type": "array", "items": { "type": "object", "required": ["component", "why", "proof"], "additionalProperties": false,
      "properties": { "component": { "$ref": "_defs#/$defs/componentRef" }, "why": { "type": "string" }, "proof": { "$ref": "_defs#/$defs/proof" } } } },
    "open_questions": { "type": "array", "items": { "type": "object", "required": ["id", "text", "blocking"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "blocking": { "type": "boolean" }, "answer": { "type": "string" } } } },
    "risk": { "enum": ["low", "medium", "high"] },
    "lite_candidate": { "type": "boolean" },
    "diagram": { "type": "string" },
    "meeting_updates_used": { "type": "array", "items": { "type": "string" } },
    "claims": { "$ref": "_defs#/$defs/claims" }
  }
}
