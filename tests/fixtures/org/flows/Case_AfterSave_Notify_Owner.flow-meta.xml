<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Notifies the case owner when a case is escalated.</description>
    <label>Case After Save Notify Owner</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <decisions>
        <name>Is_Escalated</name>
        <label>Is Escalated</label>
    </decisions>
    <recordUpdates>
        <name>Update_Case_Flag</name>
        <label>Update Case Flag</label>
        <inputAssignments>
            <field>Escalation_Reason__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <actionCalls>
        <name>Call_Service</name>
        <actionName>CaseService</actionName>
        <actionType>apex</actionType>
    </actionCalls>
    <start>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
</Flow>
